{
  "entities": {
    "Slot": {
      "title": "Slot",
      "description": "Public non-PII availability lock for a specific date and time slot.",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "minLength": 10,
          "maxLength": 10,
          "description": "Booking date in YYYY-MM-DD format."
        },
        "time": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$",
          "minLength": 5,
          "maxLength": 5,
          "description": "Time slot in HH:mm format."
        },
        "status": {
          "type": "string",
          "enum": ["booked", "blocked"],
          "description": "Whether the slot is booked by an event or manually blocked by admin."
        },
        "bookingId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Optional associated booking ID when status is booked."
        },
        "createdByUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the verified user who locked this slot."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last update."
        }
      },
      "required": ["date", "time", "status", "createdByUid", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Live tribute car reservation containing customer contact, address, songs, gifts, LGPD consent, and script.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Authenticated user UID of the booking creator."
        },
        "slotId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Deterministic slot document ID (YYYY-MM-DD_HH-mm)."
        },
        "protocol": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "description": "Human-readable booking reference code."
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "minLength": 10,
          "maxLength": 10,
          "description": "Event date in YYYY-MM-DD format."
        },
        "time": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$",
          "minLength": 5,
          "maxLength": 5,
          "description": "Event start time in HH:mm format."
        },
        "occasion": {
          "type": "string",
          "enum": ["Aniversário", "Reconciliação", "Declaração de Amor", "Homenagem Especial"],
          "description": "Tribute occasion."
        },
        "honoreeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Name of the person receiving the tribute."
        },
        "honoreeAge": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional age of the honoree."
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Name of the customer booking the event."
        },
        "clientWhatsapp": {
          "type": "string",
          "minLength": 8,
          "maxLength": 30,
          "description": "Customer WhatsApp phone number."
        },
        "neighborhood": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Neighborhood or zone in Recife / RMR."
        },
        "streetAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Street name and number."
        },
        "propertyType": {
          "type": "string",
          "enum": ["Casa", "Prédio", "Comércio"],
          "description": "Property type at the tribute location."
        },
        "referencePoint": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional landmark reference."
        },
        "giftOption": {
          "type": "string",
          "enum": ["champanhe", "chocolate", "ambos", "nenhum"],
          "description": "Selected gift option."
        },
        "includeFireworks": {
          "type": "boolean",
          "description": "Whether the 3 included fireworks displays are enabled."
        },
        "songs": {
          "type": "array",
          "description": "Exactly 3 chosen song titles."
        },
        "messageSource": {
          "type": "string",
          "enum": ["cliente", "empresa"],
          "description": "Whether client wrote the text or requested company generation."
        },
        "customMessage": {
          "type": "string",
          "maxLength": 2000,
          "description": "Custom tribute text submitted by the client."
        },
        "generatedScript": {
          "type": "string",
          "maxLength": 3000,
          "description": "Live speaker tribute script."
        },
        "basePrice": {
          "type": "number",
          "description": "Base price in BRL."
        },
        "extrasPrice": {
          "type": "number",
          "description": "Optional second gift price in BRL."
        },
        "totalPrice": {
          "type": "number",
          "description": "Total price in BRL."
        },
        "status": {
          "type": "string",
          "enum": ["Pendente", "Confirmado", "Em Rota", "Concluído", "Cancelado"],
          "description": "Current operational status."
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Operational notes and participation mode."
        },
        "lgpdConsent": {
          "type": "boolean",
          "description": "Explicit LGPD privacy policy consent accepted at reservation time."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerUid",
        "slotId",
        "protocol",
        "date",
        "time",
        "occasion",
        "honoreeName",
        "honoreeAge",
        "clientName",
        "clientWhatsapp",
        "neighborhood",
        "streetAddress",
        "propertyType",
        "referencePoint",
        "giftOption",
        "includeFireworks",
        "songs",
        "messageSource",
        "customMessage",
        "generatedScript",
        "basePrice",
        "extrasPrice",
        "totalPrice",
        "status",
        "notes",
        "lgpdConsent",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Verified customer account profile strictly isolated by owner UID.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Customer full name."
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified email address."
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Optional WhatsApp contact number."
        },
        "lgpdConsent": {
          "type": "boolean",
          "description": "Explicit LGPD privacy consent accepted on registration."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["displayName", "email", "phone", "lgpdConsent", "createdAt", "updatedAt"]
    },
    "InstagramPost": {
      "title": "InstagramPost",
      "description": "Public Instagram Reel showcase entry for @despertecoracoes managed by admin.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Video or tribute highlight title."
        },
        "instagramUrl": {
          "type": "string",
          "pattern": "^https://(www\\.)?instagram\\.com/(reel|p|tv)/[a-zA-Z0-9_\\-]+/?.*$",
          "minLength": 15,
          "maxLength": 300,
          "description": "Direct URL to the Instagram Reel or post."
        },
        "viewsLabel": {
          "type": "string",
          "maxLength": 60,
          "description": "Optional view count label (e.g., 145 mil visualizações)."
        },
        "occasion": {
          "type": "string",
          "maxLength": 60,
          "description": "Tribute occasion label."
        },
        "order": {
          "type": "number",
          "description": "Display sort order."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["title", "instagramUrl", "viewsLabel", "occasion", "order", "updatedAt"]
    },
    "QuickTemplate": {
      "title": "QuickTemplate",
      "description": "WhatsApp quick-reply message template managed by the business admin.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Template title."
        },
        "category": {
          "type": "string",
          "enum": [
            "Boas-vindas e Triagem",
            "Endereço e Orçamento",
            "Pacotes e Opcionais",
            "Dúvidas Frequentes",
            "Fechamento e Pix",
            "Confirmação e Rota"
          ],
          "description": "Template funnel category."
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000,
          "description": "Template message body with dynamic placeholders."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["title", "category", "content", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Admin role assignment document keyed by UID.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "description": "Admin user email."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["email", "createdAt"]
    },
    "PaymentSettings": {
      "title": "PaymentSettings",
      "description": "Pix deposit configuration (e.g. Ton Pix key, merchant name, city, and R$ 50 reservation deposit).",
      "type": "object",
      "properties": {
        "pixKey": {
          "type": "string",
          "maxLength": 160,
          "description": "Pix key configured by the business admin."
        },
        "merchantName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Merchant name shown in Pix receipt."
        },
        "merchantCity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Merchant city shown in Pix payload."
        },
        "depositAmount": {
          "type": "number",
          "description": "Reservation deposit amount in BRL (default 50)."
        },
        "instructions": {
          "type": "string",
          "maxLength": 400,
          "description": "Customer instructions for sending the Pix deposit receipt."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["pixKey", "merchantName", "merchantCity", "depositAmount", "instructions", "updatedAt"]
    }
  },
  "firestore": {
    "/slots/{slotId}": {
      "schema": { "$ref": "#/entities/Slot" },
      "description": "Public availability locks without PII."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Customer tribute reservations with strict owner and admin PII isolation."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Verified customer profiles strictly isolated by owner UID."
    },
    "/instagram_posts/{postId}": {
      "schema": { "$ref": "#/entities/InstagramPost" },
      "description": "Public @despertecoracoes Instagram video highlights."
    },
    "/templates/{templateId}": {
      "schema": { "$ref": "#/entities/QuickTemplate" },
      "description": "Admin-only WhatsApp quick-reply templates."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin role lookup collection."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/PaymentSettings" },
      "description": "Pix reservation deposit configuration readable by verified users and writable only by admin."
    }
  }
}
